[sub_resource type="Shader" id="Shader_yl73a"]
code = "
shader_type spatial;

uniform vec3 plaster_color : source_color = vec3(0.72, 0.69, 0.62);
uniform float texture_scale : hint_range(1.0, 30.0) = 7.0;
uniform float stroke_strength : hint_range(0.0, 1.0) = 0.5;
uniform float roughness : hint_range(0.0, 1.0) = 0.95;

varying vec3 world_pos;

float hash(vec3 p) {
	return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}

float noise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);

	float a = hash(i);
	float b = hash(i + vec3(1.0, 0.0, 0.0));
	float c = hash(i + vec3(0.0, 1.0, 0.0));
	float d = hash(i + vec3(1.0, 1.0, 0.0));

	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec3 p = world_pos * texture_scale;

	// Long, irregular plaster strokes
	float strokes = noise(vec3(p.x * 0.35, p.y * 3.0, p.z * 0.35));

	// Smaller surface imperfections
	float detail = noise(p * 4.0);

	float pattern = strokes * 0.75 + detail * 0.25;

	// Slightly uneven plaster color
	float shade = 0.78 + pattern * 0.32;

	ALBEDO = plaster_color * shade;

	// Matte plaster finish
	ROUGHNESS = roughness;
	SPECULAR = 0.12;

	// Subtle surface relief
	float bump = noise(p * 8.0);
	NORMAL = normalize(
		NORMAL + (vec3(bump) - 0.5) * stroke_strength * 0.12
	);
}


//void light() {
//	// Called for every pixel for every light affecting the material.
//	// Uncomment to replace the default light processing function with this one.
//}
"

